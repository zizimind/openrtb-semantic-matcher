# ============================================
# OpenRTB Semantic Matcher Configuration
# ============================================

# Gateway Service
GATEWAY_PORT=8080
GATEWAY_READ_TIMEOUT=5s
GATEWAY_WRITE_TIMEOUT=10s

# gRPC
GRPC_PORT=50051

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=ads

# Kafka Logging
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_REQUESTS=bid.requests
KAFKA_TOPIC_RESPONSES=bid.responses
KAFKA_COMPRESSION=zstd

# NATS JetStream
NATS_URL=nats://localhost:4222
NATS_STREAM=RTB_LOGS

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT_DIR=./data/logs

# Offline Enrichment
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# BM25 Index
BM25_INDEX_PATH=./data/bm25_index.gob
